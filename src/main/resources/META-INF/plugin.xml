<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>me.watermelon.a-touch-of-watermelon</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>Auto Some</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor email="ct-group@qq.com">ct-group</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Simple HTML elements (text formatting, paragraphs, and lists) can be added inside of <![CDATA[ ]]> tag.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
        The plugin functions are as follows (each item supports setting whether to execute or not):
        <ul>
            <li>every time after opening the project, automatically fetch all remote changes from all repositories once(supports git and svn, but relies on the corresponding version control plugins)</li>
            <li>after opening the IDE, automatically check for updates of the IDE and plugins once(once a day)</li>
        </ul>
        <br>
        插件功能如下（每项都支持设置是否执行）：
        <ul>
            <li>每次打开项目后，自动获取所有仓库远程变动一次（支持git和svn，需要依赖对应的版本控制插件）</li>
            <li>打开IDE后，自动检查IDE和插件的更新一次（一天一次）</li>
        </ul>
        <br>
        plugin setting location: File | Settings | Tools | Auto Some
        <br>
        插件设置位置：文件 | 设置 | 工具 | Auto Some
      ]]>
    </description>

    <change-notes><![CDATA[
        <h3>1.3.3</h3>
        <ul>
            <li>【启动后的自动检查更新】功能适配 IDEA 2026.3</li>
        </ul>
        <h3>1.3.2</h3>
        <ul>
            <li>remove deprecated and internal API usage</li>
        </ul>
      ]]>
    </change-notes>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends optional="true" config-file="plugin-withGit4Idea.xml">Git4Idea</depends>
    <depends optional="true" config-file="plugin-withSubversion.xml">Subversion</depends>

    <resource-bundle>messages.Bundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="me.ct.group.setting.Setting"/>
        <applicationConfigurable parentId="tools" instance="me.ct.group.setting.SettingConfig"
                                 id="me.ct.group.setting.SettingConfig" displayName="Auto Some"/>
        <!-- IDEA 2026.3 起欢迎界面是“欢迎界面项目”，需通过项目启动活动触发更新检查 -->
        <postStartupActivity implementation="me.ct.group.activity.CheckUpdateActivity"/>

        <!--<notificationGroup id="AutoSome Notification Group" displayType="BALLOON" key="notify.group.name"/>-->
    </extensions>

    <applicationListeners>
        <listener class="me.ct.group.listener.CheckUpdate" topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>
    
    <actions>
    </actions>
</idea-plugin>